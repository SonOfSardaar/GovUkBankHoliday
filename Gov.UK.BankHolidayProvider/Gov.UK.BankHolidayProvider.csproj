<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Authors>Gurpreet Singh</Authors>
    <Description>This is a utility to fetch a list of UK bank holidays provided by gov.uk</Description>
    <PackageProjectUrl>https://github.com/SonOfSardaar/GovUkBankHoliday</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SonOfSardaar/GovUkBankHoliday</RepositoryUrl>
    <RepositoryType>Git Hub</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>    
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <None Include="../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
